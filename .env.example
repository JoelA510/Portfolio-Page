# GEMINI_API_KEY: Required for Gemini AI API calls.
# Now read SERVER-SIDE only (api/_lib/handler.ts). Do NOT expose to the client.
# AI Studio / Cloud Run / Vercel injects this at runtime via the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Optional: durable rate-limit + lock state via Upstash Redis ---
# Leave unset to use in-memory stores (fine for dev or low-traffic single-instance).
# In production, add the "Upstash Redis" integration from the Vercel Marketplace —
# it auto-injects these two vars at build + runtime. Free tier is ample for a
# portfolio site (10K commands/day, 256MB).
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXXXXXXXXXXXXXXX"
