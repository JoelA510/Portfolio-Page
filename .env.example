# OPENROUTER_API_KEY: Required. Server-side only — never exposed to the client.
# The chat endpoint (api/_lib/handler.ts) uses this to call a free Gemma model
# via OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional. Override the model routed to. Defaults to the
# free Gemma 4 31B tier. Swap to another free / paid OpenRouter model ID here
# without touching code (e.g. "google/gemma-3-27b-it:free" as a known-good
# fallback if the default is unavailable).
# OPENROUTER_MODEL="google/gemma-4-31b-it:free"

# APP_URL: The URL where this applet is hosted. Sent to OpenRouter as the
# HTTP-Referer header (attribution + abuse handling). Vercel auto-sets an
# equivalent at runtime; leave unset for local dev.
APP_URL="MY_APP_URL"

# --- Optional: durable rate-limit + lock state via Upstash Redis ---
# Leave unset to use in-memory stores (fine for dev or low-traffic single-instance).
# In production, add the "Upstash Redis" integration from the Vercel Marketplace —
# it auto-injects these two vars at build + runtime. Free tier is ample for a
# portfolio site (10K commands/day, 256MB).
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXXXXXXXXXXXXXXX"
