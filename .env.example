# GEMINI_API_KEY: Required for Gemini AI API calls.
# Now read SERVER-SIDE only (api/_lib/handler.ts). Do NOT expose to the client.
# AI Studio / Cloud Run / Vercel injects this at runtime via the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Optional: distributed rate-limit + lock state via Firestore ---
# Leave unset to use in-memory stores (fine for a single function instance).
# Set to "true" in production if multiple function instances can serve traffic
# or you want state to survive redeploys.
# USE_FIRESTORE="true"

# GCP project that owns the Firestore database. Only needed when USE_FIRESTORE=true.
# On GCP-hosted runtimes (Cloud Run, Cloud Functions) this is auto-populated as
# GOOGLE_CLOUD_PROJECT. On Vercel or other hosts, set it explicitly plus
# GOOGLE_APPLICATION_CREDENTIALS_JSON with a service-account key scoped to
# roles/datastore.user.
# FIRESTORE_PROJECT_ID="my-gcp-project"
